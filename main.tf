module "VPC" {
  source = "./modules/VPC"

  AWS_REGION           = var.AWS_REGION
  PROJECT_NAME         = var.PROJECT_NAME
  VPC_CIDR             = var.VPC_CIDR
  AVAILABILITY_ZONES   = var.AVAILABILITY_ZONES
  PUBLIC_SUBNET_CIDRS  = var.PUBLIC_SUBNET_CIDRS
  PRIVATE_SUBNET_CIDRS = var.PRIVATE_SUBNET_CIDRS
  EKS_CLUSTER_NAME     = var.EKS_CLUSTER_NAME
  ENABLE_NAT_GATEWAY   = var.ENABLE_NAT_GATEWAY
}

module "GITHUB_ACTIONS_IAM" {
  source                = "./modules/GITHUB_ACTIONS_IAM"
  AWS_REGION            = var.AWS_REGION
  GITHUB_OWNER          = var.GITHUB_OWNER
  GITHUB_REPOSITORY     = var.GITHUB_REPOSITORY
  GITHUB_BRANCH         = var.GITHUB_BRANCH
  IAM_ROLE_NAME         = var.IAM_ROLE_NAME
  ECR_REPOSITORY_PREFIX = var.ECR_REPOSITORY_PREFIX
  EKS_CLUSTER_NAMES     = var.EKS_CLUSTER_NAMES
}


module "EKS_ACCESS" {
  source       = "./modules/EKS_ACCESS"
  AWS_REGION             = var.AWS_REGION
  EKS_CLUSTER_NAME       = var.EKS_CLUSTER_NAME
  GITHUB_ACTIONS_ROLE_ARN = module.GITHUB_ACTIONS_IAM.GITHUB_ACTIONS_ROLE_ARN
  KUBERNETES_NAMESPACES  = var.KUBERNETES_NAMESPACES
}

module "ECR_REPOSITORIES" {
  source = "./modules/ECR"

  AWS_REGION            = var.AWS_REGION
  ECR_REPOSITORY_NAMES  = var.ECR_REPOSITORY_NAMES
  IMAGE_TAG_MUTABILITY  = var.IMAGE_TAG_MUTABILITY
}