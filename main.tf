module "EKS_ADDONS" {
  source           = "./modules/EKS-ADD-ONS"
  EKS_CLUSTER_NAME = module.EKS.CLUSTER_NAME
  EBS_CSI_ROLE_ARN = module.IAM.EBS_CSI_ROLE_ARN
  PROJECT_NAME     = var.PROJECT_NAME
  ENVIRONMENT      = var.ENVIRONMENT
  COMMON_TAGS      = var.COMMON_TAGS
}

module "EKS" {
  source = "./modules/EKS"
  AWS_REGION          = var.AWS_REGION
  PROJECT_NAME        = var.PROJECT_NAME
  EKS_CLUSTER_NAME    = var.EKS_CLUSTER_NAME
  EKS_CLUSTER_VERSION = var.EKS_CLUSTER_VERSION
  CONTROL_PLANE_SUBNET_IDS = concat(
    module.VPC.PUBLIC_SUBNET_IDS,
    module.VPC.PRIVATE_SUBNET_IDS
  )
  PRIVATE_SUBNET_IDS    = module.VPC.PRIVATE_SUBNET_IDS
  NODE_INSTANCE_TYPE    = var.NODE_INSTANCE_TYPE
  NODE_DESIRED_SIZE     = var.NODE_DESIRED_SIZE
  NODE_MIN_SIZE         = var.NODE_MIN_SIZE
  NODE_MAX_SIZE         = var.NODE_MAX_SIZE
  EBS_CSI_IAM_ROLE_NAME = var.EBS_CSI_IAM_ROLE_NAME
}

module "LOAD_BALANCER_CONTROLLER" {
  source                = "./modules/ALB_CONTROLLER"
  AWS_REGION            = var.AWS_REGION
  EKS_CLUSTER_NAME      = module.EKS.EKS_CLUSTER_NAME
  VPC_ID                = module.VPC.VPC_ID
  EKS_OIDC_PROVIDER_ARN = module.EKS.EKS_OIDC_PROVIDER_ARN
  EKS_OIDC_ISSUER_URL   = module.EKS.EKS_OIDC_ISSUER_URL
  IAM_ROLE_NAME         = var.LOAD_BALANCER_CONTROLLER_IAM_ROLE_NAME
  HELM_CHART_VERSION    = var.HELM_CHART_VERSION
  depends_on = [
    module.EKS
  ]
}